# Bitbucket API token authentication (all four values are required).
BB_EMAIL=your.email@example.com
BB_API_TOKEN=ATBBxxx...
BB_WORKSPACE=your_workspace_name
BB_RIPPER_EXPORT_DIRECTORY=/path/to/output

# Optional: limit the number of repositories for a test run.
# BB_TEST_COUNTER=5

# Optional: organize repositories by Bitbucket project (default: false).
# BB_USE_PROJECT_FOLDERS=true
